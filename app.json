{
  "expo": {
    "name": "BudgetUP",
    "slug": "budgetup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "scheme": "budgetup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "io.github.zatsii.budgetup"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12261d",
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "monochromeImage": "./assets/icon/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "package": "io.github.zatsii.budgetup"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/icon/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12261d",
          "image": "./assets/icon/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "BudgetUP uses the microphone so you can add expenses by voice.",
          "speechRecognitionPermission": "BudgetUP converts what you say into expense details."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "BudgetUP uses the camera to scan receipts.",
          "photosPermission": "BudgetUP reads the receipt photos you choose."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
